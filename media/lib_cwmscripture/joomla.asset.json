                "lib_cwmscripture.cwm-fetch"
            ]
        },
        {
            "name": "lib_cwmscripture.scripture-autocomplete",
            "type": "script",
            "uri": "media/lib_cwmscripture/js/scripture-autocomplete.js"
        },
        {
            "name": "lib_cwmscripture.translations-manager",
            "type": "style",
            "uri": "media/lib_cwmscripture/css/translations-manager.css"
        },
        {
            "name": "lib_cwmscripture.bible-translations",
            "type": "script",
            "uri": "media/lib_cwmscripture/js/bible-translations.js",
            "dependencies": [
                "lib_cwmscripture.cwm-fetch"
            ]
        }
    ]
