<?xml version="1.0" encoding="utf-8"?>
<extension version="5.2" type="library" method="upgrade">
    <name>lib_cwmscripture</name>
	<description>LIB_CWMSCRIPTURE_DESCRIPTION</description>
	<version>1.1.3</version>
	<creationDate>May 2026</creationDate>
    <author>CWM Team</author>
    <authorEmail>info@christianwebministries.org</authorEmail>
    <authorUrl>https://www.christianwebministries.org</authorUrl>
	<copyright>(C) 2026 CWM Team All rights reserved</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<libraryname>cwmscripture</libraryname>
    <namespace path="src">CWM\Library\Scripture</namespace>
    <scriptfile>script.php</scriptfile>

	<changelogurl>https://raw.githubusercontent.com/Joomla-Bible-Study/lib_cwmscripture/main/build/lib_cwmscripture-changelog.xml</changelogurl>

	<!--
		<updateservers> goes here once the lib has its own ARS update stream.
		Create a stream of type 'libraries' under category 5 in admin, then
		add:

		<updateservers>
		    <server type="extension" name="CWM Scripture Library">https://www.christianwebministries.org/index.php?option=com_ars&amp;view=update&amp;format=xml&amp;id=LIB_STREAM_ID</server>
		</updateservers>
	-->

    <files folder="lib_cwmscripture">
        <folder>src</folder>
        <folder>sql</folder>
        <folder>language</folder>
    </files>

    <media destination="lib_cwmscripture" folder="media/lib_cwmscripture">
        <filename>joomla.asset.json</filename>
        <folder>css</folder>
        <folder>js</folder>
    </media>

    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
        </sql>
    </uninstall>
    <update>
        <schemas>
            <schemapath type="mysql">sql/updates/mysql</schemapath>
        </schemas>
    </update>

    <languages folder="lib_cwmscripture/language">
        <language tag="en-GB">en-GB/en-GB.lib_cwmscripture.ini</language>
        <language tag="en-GB">en-GB/en-GB.lib_cwmscripture.sys.ini</language>
    </languages>
</extension>
