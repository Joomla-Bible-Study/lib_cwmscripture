{
    "extension": {
        "type": "library",
        "name": "lib_cwmscripture"
    },
    "profile": "library",
    "manifests": {
        "extensions": [
            { "type": "library", "path": "cwmscripture.xml" }
        ]
    },
    "build": {
        "command":    "npm run build && cwm-build",
        "outputGlob": "build/dist/lib_cwmscripture-*.zip",
        "outputDir":  "build/dist",
        "outputName": "lib_cwmscripture-{version}.zip",
        "manifest":   "cwmscripture.xml",
        "scriptFile": "script.php",
        "sources": [
            { "from": "src",                    "to": "lib_cwmscripture/src" },
            { "from": "sql",                    "to": "lib_cwmscripture/sql" },
            { "from": "language",               "to": "lib_cwmscripture/language" },
            { "from": "media/lib_cwmscripture", "to": "media/lib_cwmscripture" }
        ],
        "excludes": [".git", ".DS_Store", ".idea", "node_modules", ".php-cs-fixer.cache"],
        "preBuild": {
            "mode": "ensure-minified",
            "dirs": ["media/lib_cwmscripture/js", "media/lib_cwmscripture/css"]
        }
    },
    "ars": {
        "endpoint": "https://www.christianwebministries.org",
        "categoryId": 6,
        "updateStreamId": 5,
        "environments": ["45", "46", "48", "49", "50"],
        "tokenItem": "CWM ARS API Token",
        "tokenVault": "CWM",
        "itemDescription": "CWM Scripture Library — shared Bible provider library used by the CWM Scripture Links plugin and Proclaim. Provides scripture lookup, caching, rendering, and translation management."
    },
    "github": {
        "owner": "Joomla-Bible-Study",
        "repo": "lib_cwmscripture",
        "releaseBranch": "main"
    },
    "changelog": {
        "file": "build/lib_cwmscripture-changelog.xml",
        "url":  "https://raw.githubusercontent.com/Joomla-Bible-Study/lib_cwmscripture/main/build/lib_cwmscripture-changelog.xml"
    }
}
